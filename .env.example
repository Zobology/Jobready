# Secure service that accepts POST /audio as multipart form data and returns:
# { "score": 0-100, "feedback": "...", "transcript": "..." }
VITE_ANALYSIS_API_URL=https://your-analysis-service.example.com

# Production identity and persistence (Supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge Function secrets; configure in Supabase, never expose with VITE_ prefixes
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Zobology <noreply@zobology.in>
NOTIFICATION_CRON_SECRET=replace-with-a-long-random-secret
