# Secure service that accepts POST /audio as multipart form data and returns:
# { "score": 0-100, "feedback": "...", "transcript": "..." }
VITE_ANALYSIS_API_URL=https://your-analysis-service.example.com

# Render web service and PostgreSQL
VITE_BACKEND_MODE=render
APP_URL=https://www.zobology.in
DATABASE_URL=postgresql://user:password@host:5432/zobology
ADMIN_EMAIL=admin@zobology.in
ADMIN_PASSWORD=replace-with-a-long-random-password

# S3-compatible private storage for audio and resumes
OBJECT_STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=zobology-private
OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# AI-first assessment review: Claude primary, OpenAI fallback
AI_PRIMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_REVIEW_MODEL=claude-sonnet-5
OPENAI_API_KEY=sk-replace-me
OPENAI_REVIEW_MODEL=gpt-5.6-sol
OPENAI_REVIEW_REASONING=medium
# Audio transcription continues through OpenAI; Claude's API does not expose speech-to-text.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_REVIEW_POLL_MS=60000
AI_REVIEW_BATCH_SIZE=3

# Transactional email for the Render notification cron job
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Zobology <noreply@zobology.in>
